@startuml
left to right direction
skinparam defaultFontName Arial
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 34
skinparam ranksep 40
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F7FAFC
  BorderColor #526579
}

actor "Сотрудник\n(кассир, менеджер, аудитор)" as Staff
actor "Администратор БД" as DBA

rectangle "Информационная система супермаркета · вариант 36" {
  package "Общие функции" {
    usecase "UC01\nВойти / завершить сеанс" as Login
    usecase "UC02\nНайти и просмотреть товар" as Browse
  }

  package "Продажа" {
    usecase "UC05–UC07\nОформить продажу:\nчерновик, оплата\nили отмена\n(кассир / менеджер)" as Sale
  }

  package "Управление товаром" {
    usecase "UC03\nСоздать / изменить / архивировать\n(менеджер)" as Manage
    usecase "UC04\nСкорректировать остаток\n(менеджер)" as Stock
  }

  package "Контроль" {
    usecase "UC08\nПросмотреть чеки:\nсвои для кассира; все\nдля менеджера и аудитора" as History
  }

  package "Эксплуатация" {
    usecase "UC09\nОбслуживать БД\n(вне Web-интерфейса)" as Admin
  }
}

Staff -- Login
Staff -- Browse
Staff -- Sale
Staff -- Manage
Staff -- Stock
Staff -- History
DBA -- Admin

@enduml
