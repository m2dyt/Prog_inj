@startuml
title Продажа на кассе · последовательность BPMN
skinparam defaultFontName Arial
skinparam shadowing false
skinparam activity {
  BackgroundColor #F7FAFC
  BorderColor #526579
}

|Кассир|
start
:Выбрать товары\nи сформировать корзину;
|Информационная система|
:Проверить корзину\nи создать черновик;
if (Данные допустимы?) then (Да)
  |Кассир|
  :Показать итог и спросить покупателя;
  if (Покупка подтверждена?) then (Да)
    :Получить наличные;
    |Информационная система|
    :Под блокировкой перепроверить остаток;\nатомарно оплатить чек и списать товар;
    if (Оплата и списание сохранены?) then (Да)
      stop
    else (Нет)
      :Оставить черновик; сообщить о нехватке;
      |Кассир|
      :Вернуть наличные;
      stop
    endif
  else (Нет)
    |Информационная система|
    :Отменить черновик;
    stop
  endif
else (Нет)
  |Информационная система|
  :Показать ошибки; остаток не менять;
  stop
endif
@enduml
