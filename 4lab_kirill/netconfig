# --- Вспомогательные функции валидации ---
validate_ipv4() {
  local ip=$1
  local rx='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
  if [[ ! $ip =~ $rx ]]; then
    return 1
  fi
  local IFS=.
  local -a octets=($ip)
  for octet in "${octets[@]}"; do
    if (( octet < 0 || octet > 255 )); then
      return 1
    fi
  done
  return 0
}

validate_netmask() {
  local mask=$1
  if ! validate_ipv4 "$mask"; then
    return 1
  fi
  local IFS=.
  local -a octets=($mask)
  local bin=""
  for octet in "${octets[@]}"; do
    local b=""
    local n=$octet
    for (( i=7; i>=0; i-- )); do
      b+=$(( (n >> i) & 1 ))
    done
    bin+="$b"
  done
  if [[ "$bin" =~ ^1*0*$ ]]; then
    return 0
  fi
  return 1
}

validate_cidr() {
  local cidr=$1
  if [[ ! "$cidr" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[1-2][0-9]|3[0-2])$ ]]; then
    return 1
  fi
  local ip="${cidr%/*}"
  validate_ipv4 "$ip"
}

validate_ifname() {
  local name=$1
  if [[ ! "$name" =~ ^[a-zA-Z0-9_.:-]+$ ]] || [[ ${#name} -gt 15 ]]; then
    return 1
  fi
  return 0
}

cidr_to_mask() {
  local prefix=$1
  local full_octets=$(( prefix / 8 ))
  local rem_bits=$(( prefix % 8 ))
  local octets=()
  for (( i=0; i<4; i++ )); do
    if (( i < full_octets )); then
      octets+=(255)
    elif (( i == full_octets )); then
      local val=0
      for (( b=0; b<rem_bits; b++ )); do
        val=$(( val + (1 << (7 - b)) ))
      done
      octets+=($val)
    else
      octets+=(0)
    fi
  done
  echo "${octets[0]}.${octets[1]}.${octets[2]}.${octets[3]}"
}

# --- Работа с файлом конфигурации ---
ensure_config_exists() {
  local file=$1
  if [[ ! -f "$file" ]]; then
    local dir
    dir=$(dirname "$file")
    if [[ ! -d "$dir" ]]; then
      if [[ $DRY_RUN -eq 1 ]]; then
        msg "${YELLOW}[DRY-RUN] Создание каталога: $dir${NOFORMAT}"
      else
        mkdir -p "$dir" || die "Не удалось создать каталог $dir" 1
      fi
    fi
    if [[ $DRY_RUN -eq 1 ]]; then
      msg "${YELLOW}[DRY-RUN] Создание начального файла: $file${NOFORMAT}"
    else
      cat <<'EOF' > "$file"
# Configuration file for ifupdown
# Managed by netconfig
auto lo
iface lo inet loopback

source /etc/network/interfaces.d/*
EOF
    fi
  fi
}

make_backup() {
  local file=$1
  if [[ -f "$file" && $DRY_RUN -eq 0 ]]; then
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local bak="${file}.bak.${timestamp}"
    cp -p "$file" "$bak" || die "Не удалось создать резервную копию $bak" 1
    BACKUP_FILE="$bak"
  fi
}

get_all_ifaces() {
  local file=$1
  [[ -f "$file" ]] || return 0
  awk '
    $1 == "iface" { print $2 }
  ' "$file" | sort -u
}

extract_stanza() {
  local file=$1
  local target_iface=$2
  awk -v target="$target_iface" '
    BEGIN { in_stanza = 0 }
    $1 == "iface" && $2 == target {
      in_stanza = 1
      print $0
      next
    }
    in_stanza && ($1 == "iface" || $1 == "mapping" || $1 == "source" || $1 == "source-directory") {
      in_stanza = 0
    }
    in_stanza {
      print $0
    }
  ' "$file"
}

write_stanza() {
  local file=$1
  local target_iface=$2
  local stanza_content=$3
  local is_auto=${4:-1}

  ensure_config_exists "$file"

  if [[ $DRY_RUN -eq 1 ]]; then
    msg "${YELLOW}[DRY-RUN] Запись строфы для интерфейса '${target_iface}' в ${file}:${NOFORMAT}"
    if [[ $is_auto -eq 1 ]]; then
      msg "${CYAN}auto ${target_iface}${NOFORMAT}"
    fi
    msg "${CYAN}${stanza_content}${NOFORMAT}"
    return 0
  fi

  make_backup "$file"

  local tmp
  tmp=$(mktemp "${file}.tmp.XXXXXX")

  awk -v target="$target_iface" -v new_stanza="$stanza_content" -v is_auto="$is_auto" '
    BEGIN {
      in_target = 0
      replaced = 0
    }
    $1 == "auto" {
      for (i = 2; i <= NF; i++) {
        if ($i == target) {
          if (NF == 2) next
        }
      }
    }
    $1 == "iface" && $2 == target {
      in_target = 1
      if (!replaced) {
        if (is_auto == 1) {
          print "auto " target
        }
        print new_stanza
        replaced = 1
      }
      next
    }
    in_target && ($1 == "iface" || $1 == "mapping" || $1 == "source" || $1 == "source-directory") {
      in_target = 0
    }
    !in_target {
      print $0
    }
    END {
      if (!replaced) {
        if (is_auto == 1) {
          print ""
          print "auto " target
        } else {
          print ""
        }
        print new_stanza
      }
    }
  ' "$file" > "$tmp"

  mv "$tmp" "$file" || die "Не удалось обновить файл конфигурации" 1
  chmod 0644 "$file"
  msg "${GREEN}Конфигурация интерфейса '${target_iface}' успешно обновлена.${NOFORMAT}"
}

remove_stanza() {
  local file=$1
  local target_iface=$2

  if [[ ! -f "$file" ]]; then
    die "Конфигурационный файл $file не найден" 2
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    msg "${YELLOW}[DRY-RUN] Удаление интерфейса '${target_iface}' из ${file}${NOFORMAT}"
    return 0
  fi

  make_backup "$file"
  local tmp
  tmp=$(mktemp "${file}.tmp.XXXXXX")

  awk -v target="$target_iface" '
    BEGIN { in_target = 0 }
    $1 == "auto" && $2 == target && NF == 2 { next }
    $1 == "iface" && $2 == target {
      in_target = 1
      next
    }
    in_target && ($1 == "iface" || $1 == "mapping" || $1 == "source" || $1 == "source-directory") {
      in_target = 0
    }
    !in_target {
      print $0
    }
  ' "$file" > "$tmp"

  mv "$tmp" "$file" || die "Не удалось обновить файл конфигурации" 1
  chmod 0644 "$file"
  msg "${GREEN}Интерфейс '${target_iface}' удален из конфигурации.${NOFORMAT}"
}

# --- Реализация подкоманд ---

cmd_set_iface() {
  local iface=$1; shift
  validate_ifname "$iface" || die "Некорректное имя интерфейса: '$iface'" 2

  local ip="" netmask="" gateway="" method="static" is_auto=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ip)
        [[ $# -ge 2 ]] || die "Параметр --ip требует значения" 2
        ip="$2"; shift 2 ;;
      --netmask)
        [[ $# -ge 2 ]] || die "Параметр --netmask требует значения" 2
        netmask="$2"; shift 2 ;;
      --gateway)
        [[ $# -ge 2 ]] || die "Параметр --gateway требует значения" 2
        gateway="$2"; shift 2 ;;
      --dhcp)
        method="dhcp"; shift ;;
      --manual)
        method="manual"; shift ;;
      --no-auto)
        is_auto=0; shift ;;
      --auto)
        is_auto=1; shift ;;
      *)
        die "Неизвестный параметр команды set-iface: '$1'" 2 ;;
    esac
  done

  if [[ "$method" == "static" ]]; then
    [[ -n "$ip" ]] || die "Для статической адресации необходимо указать --ip" 2
    if [[ "$ip" == *"/"* ]]; then
      validate_cidr "$ip" || die "Некорректный формат CIDR: '$ip'" 2
      local cidr_p="${ip#*/}"
      local plain_ip="${ip%/*}"
      if [[ -z "$netmask" ]]; then
        netmask=$(cidr_to_mask "$cidr_p")
      fi
      ip="$plain_ip"
    else
      validate_ipv4 "$ip" || die "Некорректный IPv4-адрес: '$ip'" 2
      if [[ -z "$netmask" ]]; then
        die "Для адреса без префикса необходимо указать --netmask" 2
      fi
      validate_netmask "$netmask" || die "Некорректная маска подсети: '$netmask'" 2
    fi

    if [[ -n "$gateway" ]]; then
      validate_ipv4 "$gateway" || die "Некорректный адрес шлюза: '$gateway'" 2
    fi
  fi

  local existing_routes=()
  if [[ -f "$CONFIG_FILE" ]]; then
    while IFS= read -r line; do
      if [[ "$line" =~ ^[[:space:]]*(up|down)[[:space:]]+ip[[:space:]]+route ]]; then
        existing_routes+=("$line")
      fi
    done < <(extract_stanza "$CONFIG_FILE" "$iface")
  fi

  local stanza="iface ${iface} inet ${method}"
  if [[ "$method" == "static" ]]; then
    stanza+=$'\n'"    address ${ip}"
    stanza+=$'\n'"    netmask ${netmask}"
    if [[ -n "$gateway" ]]; then
      stanza+=$'\n'"    gateway ${gateway}"
    fi
  fi

  for r in "${existing_routes[@]}"; do
    stanza+=$'\n'"${r}"
  done

  write_stanza "$CONFIG_FILE" "$iface" "$stanza" "$is_auto"

  if [[ $APPLY_NOW -eq 1 ]]; then
    msg "${YELLOW}Применение настроек интерфейса '${iface}' в ядре...${NOFORMAT}"
    if [[ $DRY_RUN -eq 1 ]]; then
      msg "${YELLOW}[DRY-RUN] ip addr flush dev ${iface} && ip addr add ${ip}/${netmask} dev ${iface}${NOFORMAT}"
    else
      command -v ip >/dev/null || die "Команда 'ip' не найдена" 1
      if [[ "$method" == "static" ]]; then
        ip addr flush dev "$iface" 2>/dev/null || true
        ip addr add "${ip}/${netmask}" dev "$iface" || die "Не удалось установить IP в ядре" 1
        if [[ -n "$gateway" ]]; then
          ip route replace default via "$gateway" dev "$iface" || true
        fi
        ip link set dev "$iface" up || true
      fi
      msg "${GREEN}Настройки успешно применены в ядре.${NOFORMAT}"
    fi
  fi
}

cmd_add_route() {
  local iface=$1; shift
  validate_ifname "$iface" || die "Некорректное имя интерфейса: '$iface'" 2

  local network="" via=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --network)
        [[ $# -ge 2 ]] || die "Параметр --network требует значения" 2
        network="$2"; shift 2 ;;
      --via)
        [[ $# -ge 2 ]] || die "Параметр --via требует значения" 2
        via="$2"; shift 2 ;;
      *)
        die "Неизвестный параметр команды add-route: '$1'" 2 ;;
    esac
  done

  [[ -n "$network" ]] || die "Параметр --network обязателен" 2
  [[ -n "$via" ]] || die "Параметр --via обязателен" 2

  if [[ "$network" == *"/"* ]]; then
    validate_cidr "$network" || die "Некорректный CIDR сети: '$network'" 2
  else
    validate_ipv4 "$network" || die "Некорректный IP адрес сети: '$network'" 2
    network="${network}/32"
  fi
  validate_ipv4 "$via" || die "Некорректный IP адрес шлюза маршрута: '$via'" 2

  ensure_config_exists "$CONFIG_FILE"
  local cur_stanza
  cur_stanza=$(extract_stanza "$CONFIG_FILE" "$iface")
  if [[ -z "$cur_stanza" ]]; then
    die "Интерфейс '$iface' не найден в $CONFIG_FILE. Сначала настройте интерфейс через set-iface" 2
  fi

  local up_cmd="    up ip route add ${network} via ${via} dev ${iface} || true"
  local down_cmd="    down ip route del ${network} via ${via} dev ${iface} || true"

  if echo "$cur_stanza" | grep -Fq "up ip route add ${network} via ${via}"; then
    msg "${YELLOW}Маршрут к сети ${network} через ${via} уже существует в конфигурации.${NOFORMAT}"
    return 0
  fi

  local new_stanza="${cur_stanza}"$'\n'"${up_cmd}"$'\n'"${down_cmd}"
  write_stanza "$CONFIG_FILE" "$iface" "$new_stanza" 1

  if [[ $APPLY_NOW -eq 1 ]]; then
    msg "${YELLOW}Применение маршрута в ядре...${NOFORMAT}"
    if [[ $DRY_RUN -eq 1 ]]; then
      msg "${YELLOW}[DRY-RUN] ip route replace ${network} via ${via} dev ${iface}${NOFORMAT}"
    else
      command -v ip >/dev/null || die "Команда 'ip' не найдена" 1
      ip route replace "${network}" via "${via}" dev "${iface}" || die "Не удалось применить маршрут в ядре" 1
      msg "${GREEN}Маршрут успешно активирован в таблице ядра.${NOFORMAT}"
    fi
  fi
}

cmd_del_route() {
  local iface=$1; shift
  validate_ifname "$iface" || die "Некорректное имя интерфейса: '$iface'" 2

  local network=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --network)
        [[ $# -ge 2 ]] || die "Параметр --network требует значения" 2
        network="$2"; shift 2 ;;
      *)
        die "Неизвестный параметр команды del-route: '$1'" 2 ;;
    esac
  done

  [[ -n "$network" ]] || die "Параметр --network обязателен" 2

  ensure_config_exists "$CONFIG_FILE"
  local cur_stanza
  cur_stanza=$(extract_stanza "$CONFIG_FILE" "$iface")
  if [[ -z "$cur_stanza" ]]; then
    die "Интерфейс '$iface' не найден в $CONFIG_FILE" 2
  fi

  local new_stanza
  new_stanza=$(echo "$cur_stanza" | grep -v -F "ip route add ${network} " | grep -v -F "ip route del ${network} " || true)

  if [[ "$cur_stanza" == "$new_stanza" ]]; then
    msg "${YELLOW}Маршрут для сети ${network} не найден в интерфейсе ${iface}.${NOFORMAT}"
    return 0
  fi

  write_stanza "$CONFIG_FILE" "$iface" "$new_stanza" 1
  msg "${GREEN}Маршрут к ${network} удален из конфигурации ${iface}.${NOFORMAT}"

  if [[ $APPLY_NOW -eq 1 ]]; then
    if [[ $DRY_RUN -eq 1 ]]; then
      msg "${YELLOW}[DRY-RUN] ip route del ${network} dev ${iface}${NOFORMAT}"
    else
      command -v ip >/dev/null || die "Команда 'ip' не найдена" 1
      ip route del "${network}" dev "${iface}" 2>/dev/null || true
      msg "${GREEN}Маршрут удален из таблицы ядра.${NOFORMAT}"
    fi
  fi
}

cmd_create_bridge() {
  local bridge=$1; shift
  validate_ifname "$bridge" || die "Некорректное имя моста: '$bridge'" 2

  local ports="" ip="" netmask="" gateway="" stp="off" fd="0" method="manual" is_auto=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ports)
        [[ $# -ge 2 ]] || die "Параметр --ports требует списка интерфейсов" 2
        ports="$2"; shift 2 ;;
      --ip)
        [[ $# -ge 2 ]] || die "Параметр --ip требует значения" 2
        ip="$2"; method="static"; shift 2 ;;
      --netmask)
        [[ $# -ge 2 ]] || die "Параметр --netmask требует значения" 2
        netmask="$2"; shift 2 ;;
      --gateway)
        [[ $# -ge 2 ]] || die "Параметр --gateway требует значения" 2
        gateway="$2"; shift 2 ;;
      --dhcp)
        method="dhcp"; shift ;;
      --stp)
        [[ $# -ge 2 ]] || die "Параметр --stp требует on или off" 2
        stp="$2"; shift 2 ;;
      --fd)
        [[ $# -ge 2 ]] || die "Параметр --fd требует число секунд" 2
        fd="$2"; shift 2 ;;
      --no-auto)
        is_auto=0; shift ;;
      *)
        die "Неизвестный параметр create-bridge: '$1'" 2 ;;
    esac
  done

  [[ -n "$ports" ]] || die "Необходимо указать хотя бы один подчиненный интерфейс через --ports" 2

  ports="${ports//,/ }"

  for p in $ports; do
    validate_ifname "$p" || die "Некорректное имя подчиненного интерфейса в мосте: '$p'" 2
  done

  if [[ "$method" == "static" ]]; then
    if [[ "$ip" == *"/"* ]]; then
      validate_cidr "$ip" || die "Некорректный CIDR адрес моста: '$ip'" 2
      local cidr_p="${ip#*/}"
      ip="${ip%/*}"
      if [[ -z "$netmask" ]]; then
        netmask=$(cidr_to_mask "$cidr_p")
      fi
    else
      validate_ipv4 "$ip" || die "Некорректный IP адрес моста: '$ip'" 2
      [[ -n "$netmask" ]] || die "Для статического IP моста укажите --netmask" 2
      validate_netmask "$netmask" || die "Некорректная маска моста: '$netmask'" 2
    fi
    if [[ -n "$gateway" ]]; then
      validate_ipv4 "$gateway" || die "Некорректный шлюз моста: '$gateway'" 2
    fi
  fi

  local stanza="iface ${bridge} inet ${method}"
  if [[ "$method" == "static" ]]; then
    stanza+=$'\n'"    address ${ip}"
    stanza+=$'\n'"    netmask ${netmask}"
    if [[ -n "$gateway" ]]; then
      stanza+=$'\n'"    gateway ${gateway}"
    fi
  fi
  stanza+=$'\n'"    bridge_ports ${ports}"
  stanza+=$'\n'"    bridge_stp ${stp}"
  stanza+=$'\n'"    bridge_fd ${fd}"

  write_stanza "$CONFIG_FILE" "$bridge" "$stanza" "$is_auto"
  msg "${GREEN}Сетевой мост '${bridge}' с портами [${ports}] успешно сконфигурирован.${NOFORMAT}"

  if [[ $APPLY_NOW -eq 1 ]]; then
    msg "${YELLOW}Создание моста '${bridge}' на уровне ядра Linux...${NOFORMAT}"
    if [[ $DRY_RUN -eq 1 ]]; then
      msg "${YELLOW}[DRY-RUN] ip link add name ${bridge} type bridge${NOFORMAT}"
      for p in $ports; do
        msg "${YELLOW}[DRY-RUN] ip link set dev ${p} master ${bridge}${NOFORMAT}"
      done
      msg "${YELLOW}[DRY-RUN] ip link set dev ${bridge} up${NOFORMAT}"
    else
      command -v ip >/dev/null || die "Команда 'ip' не найдена" 1
      if ! ip link show "$bridge" &>/dev/null; then
        ip link add name "$bridge" type bridge || die "Не удалось создать мост $bridge в ядре" 1
      fi
      for p in $ports; do
        ip link set dev "$p" up 2>/dev/null || true
        ip link set dev "$p" master "$bridge" 2>/dev/null || true
      done
      if [[ "$method" == "static" ]]; then
        ip addr flush dev "$bridge" 2>/dev/null || true
        ip addr add "${ip}/${netmask}" dev "$bridge" || true
      fi
      ip link set dev "$bridge" up || true
      msg "${GREEN}Мост '${bridge}' успешно активирован в ядре.${NOFORMAT}"
    fi
  fi
}

cmd_up() {
  local iface=$1
  validate_ifname "$iface" || die "Некорректное имя интерфейса: '$iface'" 2

  if [[ $DRY_RUN -eq 1 ]]; then
    msg "${YELLOW}[DRY-RUN] Включение интерфейса '${iface}' (ifup ${iface} / ip link set dev ${iface} up)${NOFORMAT}"
    return 0
  fi

  msg "${CYAN}Включение интерфейса '${iface}'...${NOFORMAT}"
  local ok=0
  if command -v ifup >/dev/null && [[ -f "$CONFIG_FILE" ]] && [[ "$CONFIG_FILE" == "/etc/network/interfaces" ]]; then
    if ifup "$iface" 2>/dev/null; then
      ok=1
    fi
  fi

  if [[ $ok -eq 0 ]] && command -v ip >/dev/null; then
    if ip link set dev "$iface" up; then
      ok=1
    fi
  fi

  if [[ $ok -eq 1 ]]; then
    msg "${GREEN}Интерфейс '${iface}' успешно включен.${NOFORMAT}"
  else
    die "Не удалось включить интерфейс '${iface}' (проверьте права суперпользователя и наличие устройства)" 1
  fi
}

cmd_down() {
  local iface=$1
  validate_ifname "$iface" || die "Некорректное имя интерфейса: '$iface'" 2

  if [[ $DRY_RUN -eq 1 ]]; then
    msg "${YELLOW}[DRY-RUN] Отключение интерфейса '${iface}' (ifdown ${iface} / ip link set dev ${iface} down)${NOFORMAT}"
    return 0
  fi

  msg "${CYAN}Отключение интерфейса '${iface}'...${NOFORMAT}"
  local ok=0
  if command -v ifdown >/dev/null && [[ -f "$CONFIG_FILE" ]] && [[ "$CONFIG_FILE" == "/etc/network/interfaces" ]]; then
    if ifdown "$iface" 2>/dev/null; then
      ok=1
    fi
  fi

  if [[ $ok -eq 0 ]] && command -v ip >/dev/null; then
    if ip link set dev "$iface" down; then
      ok=1
    fi
  fi

  if [[ $ok -eq 1 ]]; then
    msg "${GREEN}Интерфейс '${iface}' успешно выключен.${NOFORMAT}"
  else
    die "Не удалось отключить интерфейс '${iface}'" 1
  fi
}

cmd_show() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    msg "${YELLOW}Конфигурационный файл $CONFIG_FILE не существует.${NOFORMAT}"
    return 0
  fi

  msg "${BOLD}Файл конфигурации:${NOFORMAT} ${CONFIG_FILE}"
  echo "------------------------------------------------------------"
  
  local ifaces
  mapfile -t ifaces < <(get_all_ifaces "$CONFIG_FILE")

  if [[ ${#ifaces[@]} -eq 0 ]]; then
    echo "Сконфигурированные интерфейсы не найдены."
  else
    for iface in "${ifaces[@]}"; do
      echo -e "${BOLD}Интерфейс:${NOFORMAT} ${CYAN}${iface}${NOFORMAT}"
      local stanza
      stanza=$(extract_stanza "$CONFIG_FILE" "$iface")
      echo "$stanza" | sed 's/^/  /'
      echo ""
    done
  fi
  echo "------------------------------------------------------------"

  if command -v ip >/dev/null; then
    msg "${BOLD}Текущее состояние в ядре Linux (ip link):${NOFORMAT}"
    ip -br link show 2>/dev/null || true
  fi
}

cmd_validate() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    die "Конфигурационный файл $CONFIG_FILE не найден" 2
  fi

  msg "${CYAN}Проверка синтаксиса файла: ${CONFIG_FILE}...${NOFORMAT}"
  local errors=0
  local line_num=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    (( ++line_num ))
    [[ -z "${line// /}" ]] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue

    local first_word
    first_word=$(echo "$line" | awk '{print $1}')
    case "$first_word" in
      auto|allow-hotplug|iface|mapping|source|source-directory)
        ;;
      address|netmask|gateway|broadcast|network|metric|mtu|hwaddress|pointopoint)
        ;;
      bridge_ports|bridge_stp|bridge_fd|bridge_maxwait|bridge_waitport)
        ;;
      up|down|pre-up|post-up|pre-down|post-down)
        ;;
      *)
        msg "${YELLOW}Предупреждение [строка $line_num]: Неизвестная или нестандартная директива '${first_word}'${NOFORMAT}"
        ;;
    esac
  done < "$CONFIG_FILE"

  if [[ $errors -eq 0 ]]; then
    msg "${GREEN}Проверка завершена: синтаксических ошибок не обнаружено.${NOFORMAT}"
  else
    die "Обнаружено $errors ошибок валидации в $CONFIG_FILE" 2
  fi
}

parse_params() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage ;;
      --version)
        version ;;
      -c|--config)
        [[ $# -ge 2 ]] || die "Опция --config требует указания пути к файлу" 2
        CONFIG_FILE="$2"; shift 2 ;;
      -d|--dry-run)
        DRY_RUN=1; shift ;;
      -a|--apply)
        APPLY_NOW=1; shift ;;
      -v|--verbose)
        VERBOSE=1; set -x; shift ;;
      --no-color)
        NO_COLOR_VAL=1; shift ;;
      -*)
        die "Неизвестная опция: '$1'" 2 ;;
      *)
        break ;;
    esac
  done

  [[ $# -gt 0 ]] || usage 2

  local command=$1; shift
  case "$command" in
    show)
      cmd_show "$@" ;;
    set-iface)
      [[ $# -ge 1 ]] || die "Команда set-iface требует указания имени интерфейса" 2
      cmd_set_iface "$@" ;;
    add-route)
      [[ $# -ge 1 ]] || die "Команда add-route требует указания имени интерфейса" 2
      cmd_add_route "$@" ;;
    del-route)
      [[ $# -ge 1 ]] || die "Команда del-route требует указания имени интерфейса" 2
      cmd_del_route "$@" ;;
    create-bridge)
      [[ $# -ge 1 ]] || die "Команда create-bridge требует указания имени моста" 2
      cmd_create_bridge "$@" ;;
    del-iface|del-bridge)
      [[ $# -ge 1 ]] || die "Команда del-iface требует указания имени интерфейса" 2
      remove_stanza "$CONFIG_FILE" "$1" ;;
    up)
      [[ $# -ge 1 ]] || die "Команда up требует указания имени интерфейса" 2
      cmd_up "$1" ;;
    down)
      [[ $# -ge 1 ]] || die "Команда down требует указания имени интерфейса" 2
      cmd_down "$1" ;;
    validate)
      cmd_validate "$@" ;;
    *)
      die "Неизвестная команда: '$command'. Используйте --help для просмотра справки." 2 ;;
  esac
}

setup_colors
parse_params "$@"
