#!/usr/bin/env bash
# Лабораторная работа №4, вариант 6: Конфигурирование сетевых настроек операционной системы.
# Назначение: управление сетевыми интерфейсами, персистентными маршрутами и сетевыми мостами (/etc/network/interfaces).
set -Eeuo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)

# --- Глобальные переменные ---
CONFIG_FILE="/etc/network/interfaces"
DRY_RUN=0
APPLY_NOW=0
VERBOSE=0
NO_COLOR_VAL=0
TEMP_DIR=""
BACKUP_FILE=""

# --- Очистка и завершение ---
cleanup() {
  local exit_code=$?
  trap - SIGINT SIGTERM ERR EXIT
  if [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
    rm -rf "$TEMP_DIR"
  fi
  exit "$exit_code"
}
trap cleanup SIGINT SIGTERM ERR EXIT

setup_colors() {
  if [[ -t 2 ]] && [[ -z "${NO_COLOR-}" ]] && [[ "${TERM-}" != "dumb" ]] && [[ $NO_COLOR_VAL -eq 0 ]]; then
    NOFORMAT='\033[0m'
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    ORANGE='\033[0;33m'
    BLUE='\033[0;34m'
    PURPLE='\033[0;35m'
    CYAN='\033[0;36m'
    YELLOW='\033[1;33m'
    BOLD='\033[1m'
  else
    NOFORMAT='' RED='' GREEN='' ORANGE='' BLUE='' PURPLE='' CYAN='' YELLOW='' BOLD=''
  fi
}

msg() {
  echo >&2 -e "${1-}"
}

die() {
  local message=$1
  local code=${2-2}
  msg "${RED}Ошибка:${NOFORMAT} $message"
  exit "$code"
}

